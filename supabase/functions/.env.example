# Copy to supabase/functions/.env for local dev (auto-loaded by `supabase start`).
# For the hosted project set these with: npx supabase secrets set KEY=value
EMAIL_WEBHOOK_SECRET=local-dev-email-secret   # must match private.config 'email_webhook_secret'
EMAIL_FROM=notifications@stridelog.local      # production: an address on your Resend-verified domain
MAILPIT_URL=http://supabase_inbucket_stridelog:8025   # local only — view mail at http://127.0.0.1:54324
# RESEND_API_KEY=re_xxx                        # production: enables real sending via Resend

# Connect your own account (README, "Teams and Jira"). One app registration each.
# Microsoft: Teams / Outlook calendar (delegated Calendars.Read).
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=                              # your Directory (tenant) ID
# Atlassian: Jira (OAuth 2.0 3LO app).
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# Local only: where Microsoft / Atlassian send people back after sign in.
# CONNECT_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/connect
# TEAMS_SYNC_MOCK=true                       # local only: fake sign in and meetings
# JIRA_SYNC_MOCK=true                        # local only: fake sign in and issues
