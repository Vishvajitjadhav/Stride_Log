# Copy to supabase/functions/.env for local dev (auto-loaded by `supabase start`).
# For the hosted project set these with: npx supabase secrets set KEY=value
EMAIL_WEBHOOK_SECRET=local-dev-email-secret   # must match private.config 'email_webhook_secret'
EMAIL_FROM=notifications@stridelog.local      # production: an address on your Resend-verified domain
MAILPIT_URL=http://supabase_inbucket_stridelog:8025   # local only — view mail at http://127.0.0.1:54324
# RESEND_API_KEY=re_xxx                        # production: enables real sending via Resend

# Microsoft Teams calendar sync (see README, "Teams sync").
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# TEAMS_SYNC_MOCK=true                       # local only: fake meetings, no Microsoft needed
